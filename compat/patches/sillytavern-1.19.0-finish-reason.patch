+/**
+ * Collects provider stop / finish reason and token usage from a chat-completion-like
+ * payload (OpenAI, OpenRouter, Gemini native SSE, Claude, etc.).
+ * Later non-empty values overwrite earlier ones so the last stream chunk wins.
+ * @param {object|null|undefined} data
+ * @param {object} [prev]
+ * @returns {{ finish_reason: string|null, native_finish_reason: string|null, block_reason: string|null, usage: object|null }}
+ */
+function extractFinishState(data, prev = {}) {
+    const pickString = (...values) => {
+        for (const value of values) {
+            if (value == null) continue;
+            const text = String(value).trim();
+            if (text === '' || text === 'null' || text === 'undefined') continue;
+            return text;
+        }
+        return null;
+    };
+    const pickObject = (...values) => {
+        for (const value of values) {
+            if (value && typeof value === 'object') return value;
+        }
+        return null;
+    };
+
+    const choice = data?.choices?.[0];
+    const candidate = data?.candidates?.[0];
+
+    return {
+        finish_reason: pickString(
+            choice?.finish_reason,
+            candidate?.finishReason,
+            data?.finish_reason,
+            data?.finishReason,
+            data?.stop_reason,
+            data?.stopReason,
+            prev.finish_reason,
+        ),
+        native_finish_reason: pickString(
+            choice?.native_finish_reason,
+            candidate?.finishReason,
+            data?.stop_reason,
+            data?.stopReason,
+            data?.native_finish_reason,
+            prev.native_finish_reason,
+        ),
+        block_reason: pickString(
+            data?.promptFeedback?.blockReason,
+            data?.promptFeedback?.block_reason,
+            data?.block_reason,
+            data?.blockReason,
+            prev.block_reason,
+        ),
+        usage: pickObject(data?.usage, data?.usageMetadata, prev.usage),
+    };
+}
+
+/**
+ * Writes finish-reason fields onto a message `extra` object (in place).
+ * @param {object} extra
+ * @param {object|null|undefined} state
+ * @returns {object} extra
+ */
+function applyFinishStateToExtra(extra, state) {
+    if (!extra || typeof extra !== 'object' || !state) {
+        return extra;
+    }
+    if (state.finish_reason) extra.finish_reason = state.finish_reason;
+    if (state.native_finish_reason) extra.native_finish_reason = state.native_finish_reason;
+    if (state.block_reason) extra.block_reason = state.block_reason;
+    if (state.usage) extra.usage = state.usage;
+    return extra;
+}
